# =============================================================
# FARECAST — Airfare Intelligence India
# Environment Variables Template — Phase 4
#
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# NEVER paste credentials into chat or source code.
# =============================================================

# ----- APPLICATION -----
APP_ENV=development
APP_DEBUG=true
DEMO_MODE=true          # Set to false when live Amadeus credentials are available

# ----- DATABASE (PostgreSQL) -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=farecast
POSTGRES_USER=farecast_user
POSTGRES_PASSWORD=

# SQLAlchemy override (optional — if set, overrides POSTGRES_* fields above)
# DATABASE_URL=postgresql://farecast_user:password@localhost:5432/farecast

# For local SQLite development without PostgreSQL:
# DATABASE_URL=sqlite:///./farecast.db

# ----- IGNAV LIVE AIRFARE API (PRIMARY LIVE PROVIDER) -----
# Obtain API key from https://ignav.com
# Live search is user-triggered only; no background polling is performed.
# Leave blank to run in DEMO/HISTORICAL fallback mode.
# NEVER hardcode these in source files or commit to git.
IGNAV_API_KEY=
IGNAV_BASE_URL=https://ignav.com

# ----- AMADEUS API (ALTERNATIVE / FUTURE PROVIDER) -----
# Register free at https://developers.amadeus.com/
# Leave blank to run in DEMO/HISTORICAL mode (DEMO_MODE=true handles this)
# NEVER hardcode these in source files.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ----- CORS -----
FRONTEND_URL=http://localhost:3000

# ----- LOGGING -----
LOG_LEVEL=INFO
