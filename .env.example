# =============================================================
# FARECAST — Airfare Intelligence India
# Environment Variables Template
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# =============================================================

# ----- APPLICATION -----
APP_ENV=development
APP_DEBUG=true
DEMO_MODE=true          # Set to false when live APIs are available

# ----- DATABASE (PostgreSQL) -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=farecast
POSTGRES_USER=farecast_user
POSTGRES_PASSWORD=change_me_in_production

# SQLAlchemy connection string (auto-composed from above or override here)
# DATABASE_URL=postgresql://farecast_user:change_me_in_production@localhost:5432/farecast

# ----- AMADEUS API -----
# Register at https://developers.amadeus.com/
# Leave blank to run in DEMO/HISTORICAL mode
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test   # 'test' or 'production'

# ----- CORS -----
FRONTEND_URL=http://localhost:3000

# ----- LOGGING -----
LOG_LEVEL=INFO
